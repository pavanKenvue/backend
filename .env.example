# Copy to .env and fill in. NEVER commit .env.
# Load with:  set -a && source .env && set +a

# --- Athena (query engine for /filter_multiple_values) ---------------------
ATHENA_DATABASE=kms_sdh_analytics
ATHENA_TABLE=sv_golden_layer
ATHENA_OUTPUT_LOCATION=s3://kms-rds-analytics/athena-results/
ATHENA_REGION=us-east-1
ATHENA_POLL_INTERVAL_SECONDS=2
ATHENA_QUERY_TIMEOUT_SECONDS=40

# --- Table (fallback for ATHENA_TABLE if unset; also documents the source) -
SV_TABLE_NAME=sv_golden_layer

# --- Behaviour ------------------------------------------------------------
SV_MAX_ROWS_DEFAULT=200
SV_MAX_ROWS_CAP=1000
MIN_SEARCH_LENGTH=2
LOG_LEVEL=INFO

# --- AWS ------------------------------------------------------------------
AWS_REGION=us-east-1
ALLOWED_DOMAIN=http://localhost:5173
S3_BUCKET_NAME=argus-cpd-dashboard-web-859217211726

# Required only for the QuickSight embed endpoint (GET /).
AWS_ACCOUNT_ID=859217211726
DASHBOARD_ID=1ef7fc12-670d-4d92-a904-29e4436101a0
QUICKSIGHT_USER_ARN=arn:aws:quicksight:us-east-1:859217211726:user/default/mchaud05@kenvue.com
